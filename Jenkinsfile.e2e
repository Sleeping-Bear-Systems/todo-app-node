/* groovylint-disable-next-line CompileStatic */
pipeline {
    agent none
    options {
        disableConcurrentBuilds()
    }
    environment {
        CI = 'true'
        OP_CLI_PATH = '/usr/local/bin/'
        OP_SERVICE_ACCOUNT_TOKEN = credentials('sbs-op-service-account-token')
    }
    stages {
        stage('Playwright E2E') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.62.1-noble'
                }
            }
            environment {
                JWT_SECRET_KEY = 'op://SleepingBearSystems/sewpai64oo4a6n5vawgv5rohte/credential'
                NODE_ENV = 'test'
                POSTGRES_URI = 'op://SleepingBearSystems/a5i3avqunfzw5gttbtedbii7mi/uri'
                SEQ_API_KEY = 'op://SleepingBearSystems/kbh3ujcwvtikg5x2u72ymxfycq/credential'
                SEQ_URL = 'op://SleepingBearSystems/kbh3ujcwvtikg5x2u72ymxfycq/url'
            }
            steps {
                sh 'npm ci'
                withSecrets {
                    sh 'node --import tsx ./tools/create-database.ts --force'
                    sh 'npm run playwright:test'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
                    cleanWs()
                }
            }
        }
    }
}
