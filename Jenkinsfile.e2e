pipeline {
    agent none
    environment {
        CI = 'true'
        JWT_SECRET_KEY = 'jdAy8zhJJ8eTJem1uYyyqQdxcgQGBbs3wZUnhQgyh3JuMefBQzjs5CT5XckEZjoe'
    }
    stages {
        stage('Playwright E2E') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.60.0-jammy'
                }
            }
            steps {
                script {
                    sh 'npm ci'
                    sh 'npm run playwright:test'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'playwright-report/**', allowEmptyArchive: true
                    deleteDir()
                }
            }
        }
    }
}
