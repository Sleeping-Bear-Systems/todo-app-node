pipeline {
    agent none
    stages {
        stage('Playwright E2E') {
            agent {
                docker {
                    image 'mcr.microsoft.com/playwright:v1.60.0-jammy'
                }
            }
            steps {
                script {
                    sh 'npm ci'
                    sh 'npm run playwright:test'
                }
            }
        }
    }
    post {
      always {
        deleteDir()
      }
    }
}
