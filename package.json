{
  "$schema": "https://json.schemastore.org/package.json",
  "dependencies": {
    "@datalust/winston-seq": "^3.0.1",
    "@event-driven-io/emmett": "^0.42.3",
    "@event-driven-io/emmett-sqlite": "^0.42.3",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "hono": "^4.12.23",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node26": "^26.0.0",
    "@tsconfig/strictest": "^2.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "tsx": "^4.7.1",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#features/*": "./src/features/*",
    "#shared/*": "./src/shared/*"
  },
  "name": "todo-app-node",
  "private": true,
  "scripts": {
    "biome:check": "biome check .",
    "biome:ci": "biome ci .",
    "biome:fix": "biome check --write .",
    "build": "tsc -b",
    "build:force": "tsc -b --force",
    "dev": "tsx watch --tsconfig tsconfig.app.json ./src/index.ts",
    "dev:e2e": "tsx --tsconfig tsconfig.app.json ./src/index.ts",
    "playwright:install": "playwright install",
    "playwright:test": "playwright test",
    "playwright:test:non-blocking": "playwright test --reporter=line",
    "playwright:test:headed": "playwright test --headed",
    "playwright:test:ui": "playwright test --ui",
    "playwright:report": "playwright show-report",
    "start": "tsx --tsconfig tsconfig.app.json ./src/index.ts",
    "test": "node --import tsx --test ./src/**/*.test.ts"
  },
  "type": "module",
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true,
    "sqlite3@5.1.7": true
  }
}
