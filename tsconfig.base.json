{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@tsconfig/node24", "@tsconfig/strictest"],
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "verbatimModuleSyntax": true
  }
}
