{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "#features/*": ["./src/features/*"],
      "#shared/*": ["./src/shared/*"]
    },
    "rootDir": "./src"
  },
  "extends": "./tsconfig.base.json"
}
