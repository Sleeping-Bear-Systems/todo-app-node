/* groovylint-disable CompileStatic */
pipeline {
    agent none
    environment {
        BUILD_TIMESTAMP = "${new Date().format('yyyyMMdd-HHmmss', TimeZone.getTimeZone('UTC'))}"
        OP_CLI_PATH = '/usr/local/bin/'
        OP_SERVICE_ACCOUNT_TOKEN = credentials('sbs-op-service-account-token')
    }
    stages {
        stage('Deploy Production') {
            agent { label 'docker' }
            environment {
                ADMIN_PASSWORD = 'op://SleepingBearSystems/qypc6wb66va4hqsr53i3fhvpoe/username'
                ADMIN_USERNAME = 'op://SleepingBearSystems/qypc6wb66va4hqsr53i3fhvpoe/username'
                CONTAINER_NAME = 'todo-app-prod'
                HOST_PORT = '3600'
                JWT_SECRET_KEY = 'op://SleepingBearSystems/sewpai64oo4a6n5vawgv5rohte/credential'
                POSTGRES_URI = 'op://SleepingBearSystems/33rsxifu44baslarw7hg6eeltm/uri'
                REPOSITORY = 'todo-app'
                SEQ_API_KEY = 'op://SleepingBearSystems/kbh3ujcwvtikg5x2u72ymxfycq/credential'
                SEQ_URL = 'op://SleepingBearSystems/kbh3ujcwvtikg5x2u72ymxfycq/url'
            }
            steps {
                withSecrets {
                    sh '''
                        docker build \
                        --tag "$REPOSITORY:$BUILD_TIMESTAMP" \
                        --tag $REPOSITORY:latest .
                        '''
                    sh 'docker stop $CONTAINER_NAME || true && docker rm $CONTAINER_NAME || true'
                    sh '''
                        docker run \
                        --detach \
                        --publish $HOST_PORT:3000 \
                        --restart unless-stopped \
                        --name $CONTAINER_NAME \
                        --env NODE_ENV=production \
                        --env POSTGRES_URI \
                        --env SEQ_API_KEY \
                        --env SEQ_URL \
                        --env JWT_SECRET_KEY \
                        --env ADMIN_USERNAME \
                        --env ADMIN_PASSWORD \
                        --env BUILD_NUMBER \
                        $REPOSITORY:$BUILD_TIMESTAMP
                    '''
                }
            }
            post {
                always {
                    cleanWs()
                }
            }
        }
    }
}
