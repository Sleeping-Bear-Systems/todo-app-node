@baseUrl = http://localhost:3000
@origin = http://localhost:3000

### Login (valid credentials)
POST {{baseUrl}}/api/login
Origin: {{origin}}
Content-Type: application/x-www-form-urlencoded

username=admin&password=password1234

### Login (invalid credentials)
POST {{baseUrl}}/api/login
Origin: {{origin}}
Content-Type: application/x-www-form-urlencoded

username=admin&password=wrong-password

### Logout
POST {{baseUrl}}/api/logout
Origin: {{origin}}

### Add Task
POST {{baseUrl}}/api/auth/add-task
Origin: {{origin}}
Content-Type: application/x-www-form-urlencoded

title=Task+1&description=My+first+task

### Add Task (default description)
POST {{baseUrl}}/api/auth/add-task
Origin: {{origin}}
Content-Type: application/x-www-form-urlencoded

title=Task+no+description

### Complete Task
POST {{baseUrl}}/api/auth/complete-task/efcffee8-abc6-4161-9ca3-d17cf2fafe68
Origin: {{origin}}
